# Optional settings. The project does not read this file automatically: set the
# variables in the terminal before starting the backend / dashboard, e.g.
#   PowerShell:  $env:DT_TICK_SECONDS = "2"
#   cmd.exe:     set DT_TICK_SECONDS=2
# All have sensible defaults; you normally do not need any of them.

# --- backend (backend/main.py, simulator.py, database.py, train_models.py) ---
DT_TICK_SECONDS=5            # wall-clock seconds between simulation steps / stored readings
DT_SIM_SEED=42               # random seed of the building simulation (reproducible scenarios)
DT_SIM_FAULT_FRACTION=0.02   # share of time each room spends in a random fault episode (0 disables)
DT_BOOTSTRAP=1               # 1 = on first start, simulate history and train models if missing
DT_HISTORY_DAYS=10           # days of history simulated by the bootstrap
DT_DB_PATH=                  # default: data/digital_twin.db
DT_MODELS_DIR=               # default: models/

# --- dashboard (dashboard/app.py) ---
DT_API_BASE=http://localhost:8000
DT_TWIN_URL=http://localhost:8000/twin/
